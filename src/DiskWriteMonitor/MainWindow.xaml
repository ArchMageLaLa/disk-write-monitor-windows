<Window x:Class="DiskWriteMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DiskWriteMonitor.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="磁盘写入量"
        Width="600" Height="776"
        WindowStyle="None" ResizeMode="CanMinimize"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#22FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 自绘标题栏（WindowStyle=None，所以要自己实现拖动） -->
            <Grid Grid.Row="0" Background="{StaticResource BgBrush}"
                  MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Image Source="/resources/app.ico" Width="14" Height="14" VerticalAlignment="Center" />
                    <TextBlock Text="磁盘写入量" FontSize="12" Margin="8,0,0,0"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="—" Style="{StaticResource TitleButton}" Click="Minimize_Click" />
                    <Button Content="✕" Style="{StaticResource TitleButton}" Click="Close_Click" Margin="0,0,6,0" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="22,0,22,16">

                <!-- ① 设备 + 状态 + 暂停 -->
                <Grid Margin="0,2,0,14">
                    <StackPanel>
                        <TextBlock Text="{Binding DeviceTitle}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding DeviceSubtitle}" Style="{StaticResource Caption}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Border Background="{Binding StatusLevel, Converter={StaticResource StatusBg}}"
                                CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5" Height="5" VerticalAlignment="Center"
                                         Fill="{Binding StatusLevel, Converter={StaticResource StatusBrush}}" />
                                <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="5,0,0,0"
                                           Foreground="{Binding StatusLevel, Converter={StaticResource StatusBrush}}" />
                            </StackPanel>
                        </Border>
                        <Button Content="{Binding PauseText}" Style="{StaticResource FlatButton}"
                                Margin="6,0,0,0" Click="Pause_Click" />
                    </StackPanel>
                </Grid>

                <!-- 多盘选择：只有一块盘时整块隐藏 -->
                <ItemsControl ItemsSource="{Binding DiskChips}" Margin="0,0,0,12"
                              Visibility="{Binding ShowDiskSelector, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="10,6" Margin="0,0,8,0" Cursor="Hand"
                                    Background="{Binding Background}"
                                    BorderBrush="{Binding BorderBrush}" BorderThickness="1"
                                    Tag="{Binding Disk.Number}"
                                    MouseLeftButtonUp="DiskChip_Click">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontSize="11"
                                               Foreground="{Binding TextBrush}" />
                                    <TextBlock Text="{Binding Detail}" FontSize="10" Margin="0,2,0,0"
                                               Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 权限提示条：读不到 SMART 时出现，可一键提权重启 -->
                <Border x:Name="PermissionBar" Visibility="Collapsed" CornerRadius="9" Padding="12,9"
                        Margin="0,0,0,12" Background="#2EFBBF24">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding StatusTitle}" FontSize="12"
                                       Foreground="{StaticResource WarnBrush}" />
                            <TextBlock x:Name="PermissionText" Style="{StaticResource Caption}" Margin="0,3,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Content="以管理员身份重启" Style="{StaticResource FlatButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Foreground="{StaticResource WarnBrush}" Click="RestartElevated_Click"
                                Visibility="{Binding ShowPermissionBar, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>

                <!-- 更新提示条 -->
                <Border x:Name="UpdateBanner" Visibility="Collapsed" CornerRadius="9" Padding="12,9"
                        Margin="0,0,0,12" Background="#1F38BDF8">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="↑" Foreground="{StaticResource AccentBrush}" FontSize="12"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="UpdateText" FontSize="12" Margin="8,0,0,0"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                            <Button Content="查看" Style="{StaticResource FlatButton}" Margin="10,0,0,0"
                                    Foreground="{StaticResource AccentBrush}" Click="OpenRelease_Click" />
                        </StackPanel>
                        <Button Content="✕" Style="{StaticResource FlatButton}" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="DismissUpdate_Click" />
                    </Grid>
                </Border>

                <!-- ② 当前写入速度 -->
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="当前写入速度" Style="{StaticResource Caption}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding RateValue}" FontSize="40" FontWeight="Light"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="{Binding RateUnit}" Style="{StaticResource Caption}"
                                   VerticalAlignment="Bottom" Margin="8,0,0,9" />
                    </StackPanel>
                </StackPanel>

                <!-- ③ 曲线 -->
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="{Binding ChartTitle}" Style="{StaticResource Body}" FontSize="11" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding SelectionHint}" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" />
                        <Button Content="清除" Style="{StaticResource FlatButton}" Margin="6,0,0,0"
                                Click="ClearSelection_Click" />
                    </StackPanel>
                </Grid>

                <controls:LineChart Height="186" Data="{Binding Chart}" Margin="0,0,0,2" />

                <Grid Margin="44,0,4,14">
                    <TextBlock Text="60 秒前" Style="{StaticResource Caption}" FontSize="10" />
                    <TextBlock Text="现在" Style="{StaticResource Caption}" FontSize="10"
                               HorizontalAlignment="Right" />
                </Grid>

                <!-- ④ 四宫格 -->
                <UniformGrid Columns="4" Margin="0,0,0,16">
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,3,0">
                        <StackPanel>
                            <TextBlock Text="本次会话写入" Style="{StaticResource Caption}" FontSize="10" />
                            <TextBlock Text="{Binding SessionText}" Style="{StaticResource Body}"
                                       FontSize="15" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding SessionCaption}" Style="{StaticResource Caption}"
                                       FontSize="9" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="10,8" Margin="3,0">
                        <StackPanel>
                            <TextBlock Text="累计写入" Style="{StaticResource Caption}" FontSize="10" />
                            <TextBlock Text="{Binding TotalText}" Style="{StaticResource Body}"
                                       FontSize="15" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding TotalCaption}" Style="{StaticResource Caption}"
                                       FontSize="9" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="10,8" Margin="3,0">
                        <StackPanel>
                            <TextBlock Text="本次峰值" Style="{StaticResource Caption}" FontSize="10" />
                            <TextBlock Text="{Binding PeakText}" Style="{StaticResource Body}"
                                       FontSize="15" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="10,8" Margin="3,0,0,0">
                        <StackPanel>
                            <TextBlock Text="硬盘温度" Style="{StaticResource Caption}" FontSize="10" />
                            <TextBlock Text="{Binding TempText}" Style="{StaticResource Body}"
                                       FontSize="15" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- ⑤ 谁在写 -->
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="{Binding ProcessSectionTitle}" Style="{StaticResource Body}" FontSize="11" />
                    <TextBlock Text="{Binding ProcessCountText}" Style="{StaticResource Caption}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <ListBox ItemsSource="{Binding Rows}" Height="162" Background="Transparent"
                         BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Height="18" CornerRadius="4" Margin="0,0,0,6"
                                    Background="{Binding RowBackground}" Cursor="Hand"
                                    MouseLeftButtonUp="Row_MouseUp">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="76" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Width="6" Height="6" Fill="{Binding DotBrush}"
                                             VerticalAlignment="Center" HorizontalAlignment="Center" />

                                    <Border Grid.Column="1" Width="3" CornerRadius="1.5"
                                            Background="{Binding BarBrush}"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />

                                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12"
                                               Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,8,0" />

                                    <Border Grid.Column="3" Height="5" CornerRadius="2.5"
                                            Background="{StaticResource TrackBrush}"
                                            VerticalAlignment="Center" HorizontalAlignment="Right"
                                            Width="96">
                                        <Border Height="5" CornerRadius="2.5" HorizontalAlignment="Left"
                                                Tag="barfill"
                                                Background="{Binding BarBrush}"
                                                Width="{Binding Percent, Converter={StaticResource PercentWidth}, ConverterParameter=96}" />
                                    </Border>

                                    <TextBlock Grid.Column="4" Text="{Binding BytesText}" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- ⑥ 底部 -->
                <Grid Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="AutoStartCheck" Style="{StaticResource PillSwitch}"
                                  VerticalAlignment="Center" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed">
                            <TextBlock Text="开机自启" Style="{StaticResource Caption}" />
                        </CheckBox>
                        <Button x:Name="DataDirButton" Style="{StaticResource FlatButton}" Margin="10,0,0,0"
                                Padding="6,3" FontSize="10" VerticalAlignment="Center"
                                Content="数据目录" Click="DataDir_Click"
                                ToolTipService.ShowDuration="20000" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DataSourceText}" Style="{StaticResource Caption}"
                                   FontSize="10" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding LastUpdateText}" Style="{StaticResource Caption}"
                                   FontSize="10" HorizontalAlignment="Right" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

            </StackPanel>
        </Grid>
    </Border>
</Window>
